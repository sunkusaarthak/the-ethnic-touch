# Server & Security
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SUPER_ADMIN_EMAIL=admin@ethnictouch.com
FIREBASE_WEB_API_KEY=AIzaSy_placeholder_firebase_web_api_key

# Database (PostgreSQL / Aiven / Neon / Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=ethnictouch
DB_SSLMODE=disable
# Optional direct connection string
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Payment Providers (razorpay | mock)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Shipping & Logistics (delhivery | mock)
SHIPPING_PROVIDER=delhivery
DELHIVERY_API_KEY=delhivery_api_key_placeholder
DELHIVERY_WEBHOOK_SECRET=delhivery_webhook_secret_placeholder

# Cloudinary (Legacy / Secondary Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 (Primary Image & Asset Storage)
CF_R2_ACCOUNT_ID=your_cloudflare_account_id
CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CF_R2_BUCKET_NAME=ethnic-touch-images
CF_R2_PUBLIC_URL=https://<bucket-id>.r2.dev

# Email / Transactional Mailer (SMTP / Gmail App Password)
GMAIL_USER=orders@theethnictouch.com
GMAIL_APP_PASSWORD=your_16_character_app_password
EMAIL_FROM_NAME="The Ethnic Touch"
EMAIL_FROM_ADDRESS=orders@theethnictouch.com
EMAIL_REPLY_TO=theethnictouchsupport@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
